<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ v3.7.14 小组件背景：半透明「液态玻璃」。

  设计意图（对齐 iQOO / OriginOS 的液态玻璃观感）：
   · 底色用**半透明深色**（约 62% 不透明），而不是原来的实心暖橙。
     这样桌面壁纸会透上来，形成"毛玻璃下面是壁纸"的层次；
     同时保证白字在浅色壁纸上依然读得清（这是选深色而非浅色的原因）。
   · 圆角加大到 24dp，接近 OriginOS 大圆角的观感。
   · 叠一层从上到下的**白色高光渐变**：顶部稍亮、底部渐隐，
     模拟玻璃边缘的折光，这是"液态感"的关键一笔。

  注意：RemoteViews 背景只能是 drawable 资源，不能做真实的背景模糊
  （那是 WindowManager 的 BLUR_BEHIND，AppWidget 用不了），
  所以用「半透明 + 高光 + 细描边」来近似玻璃效果。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层：半透明深色底 + 大圆角 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#9E1A1A22"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- 高光层：顶亮底透的白色渐变，营造玻璃折光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#3DFFFFFF"
                android:centerColor="#14FFFFFF"
                android:endColor="#08FFFFFF"
                android:type="linear"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>

    <!-- 描边：一圈若隐若现的白边，液态玻璃的"边缘" -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#4DFFFFFF"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
