<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ v3.7.15 小组件背景：对齐 iQOO 通知播放器截图里的「毛玻璃圆角卡」。

  与 v3.7.14 的差别：
   · 深浅调淡：截图的卡面是**浅色半透明的灰白**，不是 v3.7.14 的深色。
     但纯浅色会让白字看不见 → 所以取"中性偏冷的半透明灰"（#CC2A2E3A），
     在白墙壁纸上呈现浅灰玻璃，在深色壁纸上呈现深灰玻璃，白字都读得清。
   · 圆角收敛到 26dp（截图卡片圆角约等于卡片高度的 1/8）。
   · 高光从"顶亮"改为"顶部一条窄高光带"——截图里的折光只占顶边一小条，
     整块渐变会让卡片显得"发灰"。这里高光层高度用 gradient 的 endColor 快速收掉。
   · 描边保留但减淡到 30% 白，避免边界过硬。

  说明：AppWidget 用不了真实的背景模糊（WindowManager 的 BLUR_BEHIND 不可及），
  只能用「半透明 + 高光 + 细描边」近似玻璃质感。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层：半透明中性灰底 + 大圆角 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC2A2E3A"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>

    <!-- 高光层：顶部窄带折光 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>

    <!-- 描边：一圈淡白边，勾出玻璃边缘 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#30FFFFFF"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
</layer-list>
