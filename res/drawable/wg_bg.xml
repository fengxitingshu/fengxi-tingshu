<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ v3.8.2 小组件背景：对齐通知播放器截图里的「毛玻璃圆角卡」。

  半透明中性灰底（#CC2A2E3A）：在白墙壁纸上呈浅灰玻璃，在深色壁纸上
  呈深灰玻璃，白字两种场景都读得清。圆角 26dp（约卡片高度的 1/8）。
  顶部一条窄高光带 + 30% 白细描边，近似玻璃折光。

  说明：AppWidget 拿不到真实的背景模糊（WindowManager BLUR_BEHIND 不可及），
  只能用「半透明 + 高光 + 细描边」逼近玻璃质感。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 底层：半透明中性灰底 + 大圆角 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC2A2E3A"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>

    <!-- 高光层：顶部窄带折光（快速收掉，避免整块发灰） -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#30FFFFFF"
                android:centerColor="#0AFFFFFF"
                android:endColor="#00FFFFFF"
                android:type="linear"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>

    <!-- 描边：一圈淡白边，勾出玻璃边缘 -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#30FFFFFF"/>
            <corners android:radius="26dp"/>
        </shape>
    </item>
</layer-list>
