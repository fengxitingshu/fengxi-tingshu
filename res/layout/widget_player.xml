<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ v3.7.11 桌面播放控制小组件布局。

  约束：RemoteViews 只支持有限的控件集合 —— LinearLayout / FrameLayout /
  RelativeLayout / ImageView / TextView / ProgressBar / Button 等，
  不能用 ConstraintLayout、不能用自定义 View、不能用 <include>。
  所以这里全部用 LinearLayout + FrameLayout 拼出来。

  另一条硬约束：ProgressBar 的 progressTint 在 API 21 上不支持，
  所以进度条用系统默认样式 + 自定义 drawable 背景来代替换色。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/wg_bg"
    android:padding="12dp">

    <!-- 上半：封面 + 文字 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 封面 -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="64dp"
            android:layout_marginRight="10dp">

            <ImageView
                android:id="@+id/wgCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/wg_cover_bg"
                android:contentDescription="@string/wg_cover"/>

            <!-- 无封面时的占位：一个音符 -->
            <TextView
                android:id="@+id/wgCoverPh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/wg_cover_bg"
                android:gravity="center"
                android:text="♪"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:visibility="gone"/>
        </FrameLayout>

        <!-- 书名 + 副标题 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wgTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                android:text="@string/app_name"/>

            <TextView
                android:id="@+id/wgSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#E8E8E8"
                android:textSize="11.5sp"
                android:text="@string/wg_idle"/>

            <TextView
                android:id="@+id/wgTime"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:textColor="#CFCFCF"
                android:textSize="10.5sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 进度条 -->
    <ProgressBar
        android:id="@+id/wgBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="1000"
        android:progress="0"
        android:progressDrawable="@drawable/wg_progress"/>

    <!-- 下半：三键控制 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/wgPrev"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_previous"
            android:contentDescription="@string/wg_prev"/>

        <ImageView
            android:id="@+id/wgToggle"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:padding="6dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_play"
            android:contentDescription="@string/wg_toggle"/>

        <ImageView
            android:id="@+id/wgNext"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_next"
            android:contentDescription="@string/wg_next"/>
    </LinearLayout>
</LinearLayout>
