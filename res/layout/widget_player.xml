<?xml version="1.0" encoding="utf-8"?>
<!--
  ★ v3.8.2 小组件布局：样式参考通知栏播放控制（Notification.MediaStyle）。

  与通知栏的对应关系：
   · 封面 = 通知大图标位（62dp 方形圆角，居左）
   · 书名/副标题（作者 · 源 · 集名）= 通知 title/contentText
   · 进度条 + 时间 = 通知进度段
   · 四键（上一集/播放暂停/下一集/停止）与通知栏动作**顺序一致**

  ★ RemoteViews 白名单（v3.7.15 踩过的坑）：
   进度条上的 20 格点击区必须用 <ImageView>，不能用 <View> ——
   View 标签不在 RemoteViews 白名单里，桌面启动器 inflate 失败
   会导致整块小组件渲染空白。这里 20 格全部是 ImageView。

  ★ 可点进度条：
   RemoteViews 不支持 SeekBar（AbsSeekBar 不在白名单），无法真拖动。
   替代方案：进度条上盖 20 格透明点击区，点第 i 格 = seek 到
   (i+0.5)/20。粒度 5%，听书（单章 20~60 分钟）足够。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wgRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/wg_bg"
    android:paddingLeft="14dp"
    android:paddingRight="14dp"
    android:paddingTop="12dp"
    android:paddingBottom="10dp">

    <!-- 上半：封面 + 书名/副标题（点这里打开 App） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <FrameLayout
            android:id="@+id/wgCoverTap"
            android:layout_width="62dp"
            android:layout_height="62dp">

            <ImageView
                android:id="@+id/wgCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:background="@drawable/wg_cover_bg"
                android:contentDescription="@string/wg_cover"/>

            <TextView
                android:id="@+id/wgCoverPh"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/wg_cover_bg"
                android:gravity="center"
                android:text="♪"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:visibility="gone"/>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/wgInfoTap"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="13dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wgTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="@string/app_name"/>

            <TextView
                android:id="@+id/wgSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:singleLine="true"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:scrollHorizontally="true"
                android:textColor="#C9FFFFFF"
                android:textSize="12.5sp"
                android:shadowColor="#80000000"
                android:shadowDx="0"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="@string/wg_idle"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 中部：当前时间 + 可点进度条 + 总时长 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/wgTimeCur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="34dp"
            android:singleLine="true"
            android:gravity="left"
            android:textColor="#D9FFFFFF"
            android:textSize="10.5sp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"/>

        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="22dp"
            android:layout_weight="1"
            android:layout_marginLeft="7dp"
            android:layout_marginRight="7dp">

            <ProgressBar
                android:id="@+id/wgBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="4dp"
                android:layout_gravity="center_vertical"
                android:max="1000"
                android:progress="0"
                android:progressDrawable="@drawable/wg_progress"/>

            <!-- 20 格透明点击层：点第 i 格 seek 到 (i+0.5)/20。
                 ★ 必须是 ImageView（RemoteViews 白名单），不能用 View。 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <ImageView android:id="@+id/wgSeek0"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek1"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek2"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek3"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek4"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek5"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek6"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek7"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek8"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek9"  android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek10" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek11" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek12" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek13" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek14" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek15" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek16" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek17" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek18" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
                <ImageView android:id="@+id/wgSeek19" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"/>
            </LinearLayout>
        </FrameLayout>

        <TextView
            android:id="@+id/wgTimeDur"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="34dp"
            android:singleLine="true"
            android:gravity="right"
            android:textColor="#D9FFFFFF"
            android:textSize="10.5sp"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="2"/>
    </LinearLayout>

    <!-- 下半：四键控制（顺序与通知栏一致：上一集/播放暂停/下一集/停止，无背板） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/wgPrev"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_previous"
            android:tint="#FFFFFF"
            android:contentDescription="@string/wg_prev"/>

        <ImageView
            android:id="@+id/wgToggle"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_play"
            android:tint="#FFFFFF"
            android:contentDescription="@string/wg_toggle"/>

        <ImageView
            android:id="@+id/wgNext"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_media_next"
            android:tint="#FFFFFF"
            android:contentDescription="@string/wg_next"/>

        <ImageView
            android:id="@+id/wgStop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF"
            android:contentDescription="@string/wg_stop"/>
    </LinearLayout>
</LinearLayout>
