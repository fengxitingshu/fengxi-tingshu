<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.tingshu.app"
        android:versionCode="91"
        android:versionName="3.9.39">

    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="28"/>

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- ★ v3.9.0：本地书源扫描本机音频（API 33+ 用细分权限，以下用旧权限） -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>
    <!-- ★ v2.8：自绘悬浮球需要「显示在其他应用上层」权限（用户需在系统设置里手动授予） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>

    <application
        android:name=".core.App"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true"
        android:hardwareAccelerated="true"
        android:extractNativeLibs="true"
        android:allowBackup="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <service
            android:name=".player.PlayerService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"/>

        <!-- ★ v3.8.2：桌面播放控制小组件（样式参考通知栏控制）。
             必须 exported="false" —— 状态刷新广播是 App 自己发的，
             不该对外暴露；点击则走下面 exported 的 WidgetClickReceiver。 -->
        <receiver
            android:name=".widget.PlayerWidgetProvider"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_player_info"/>
        </receiver>

        <!-- ★ v3.8.2：小组件点击接收器。
             必须 exported="true" —— 桌面（launcher）是另一个 App，它触发
             小组件上的 PendingIntent 时系统会按 exported 校验；投给
             exported="false" 的组件会被静默丢弃，表现为"按钮和进度条
             点了没反应、只有点封面能回 App"（v3.7.16 踩过的坑）。
             本接收器只做「转发到 PlayerService」一件事，且只认自己的 action。 -->
        <receiver
            android:name=".widget.WidgetClickReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.tingshu.app.widget.ACTION"/>
            </intent-filter>
        </receiver>

        <!-- ★ v2.8：自绘悬浮球。独立前台服务，由 MainActivity 随播放状态启停。
             不写 foregroundServiceType —— targetSdk=28 下系统不校验该属性，
             写了反而在部分高版本 ROM 上因类型不匹配（specialUse 是 API 34 概念）出问题。 -->
        <service
            android:name=".player.FloatBallService"
            android:enabled="true"
            android:exported="false"/>

        <!-- ★ v2.2：媒体浏览服务 —— 让 iQOO 自带音乐/车机/Android Auto 等
             系统「音源选择器」能发现并列出本 App。
             必须声明 android.media.browse.MediaBrowserService 这个 action，
             否则系统扫描不到（适配了却不显示的头号原因）。 -->
        <service
            android:name=".player.PlayerBrowserService"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>

        <!-- ★ v3.7.18：桌面播放控制小组件已整体移除（用户反馈其长期无法正常
             工作，且占用额外资源）。相关代码 —— PlayerWidgetProvider、
             WidgetClickReceiver、WidgetState、widget_player.xml 布局与
             wg_*.xml 绘制资源 —— 已全部删除。
             桌面播放控制改由「通知栏控制条 + 系统 MediaSession」承担，
             原子随身听 / 音乐控制中心仍可正常读取与操控播放。 -->
    </application>
</manifest>
